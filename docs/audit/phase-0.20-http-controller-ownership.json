 "purpose": "Plan section 15 ownership assignment per controller, and the recorded decision on why Admin/Partner/Provider subdirectories were NOT created.",
 "directory_decisions": [
  {
   "proposed_dir": "Controllers/Admin",
   "exists": false,
   "created": false,
   "controller_count": 8,
   "decision": "NOT CREATED",
   "reason": "Every route is registered under the /api prefix. The admin/partner/provider split is a controller NAMING convention, not a route or filesystem boundary. Creating these directories would be name-based reorganisation and would churn 30+ classes to improve a conformance percentage, which plan section 15 and section 45 both forbid."
  },
  {
   "proposed_dir": "Controllers/Partner",
   "exists": false,
   "created": false,
